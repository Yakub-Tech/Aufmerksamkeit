# Diese Datei muss man zu einer .env kopieren:
#   cp .env.example .env
#
# Wenn man die App mit docker-compose startet, passt der Host "db".
# Bei lokalem npm run dev ohne Docker muss man "db" durch "localhost" ersetzen.

# Postgres Credentials (werden von docker-compose für den db-Service genutzt)
POSTGRES_USER=KeineAhnung
POSTGRES_PASSWORD=WasWeisIch
POSTGRES_DB=webanwendung

# Connection-String für Prisma / die Web-App
DATABASE_URL="postgresql://KeineAhnung:WasWeisIch@db:5432/webanwendung"
