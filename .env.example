# Local Docker demo only. Replace credentials before any real deployment.
POSTGRES_USER=aufmerksamkeit_app
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=aufmerksamkeit
DATABASE_URL="postgresql://aufmerksamkeit_app:local-demo-password@db:5432/aufmerksamkeit"
# Adds fictional results and comments on an empty database; false disables seeding.
SEED_DEMO=true
# Local HTTP only. Keep true when deploying with HTTPS.
SESSION_COOKIE_SECURE=false
