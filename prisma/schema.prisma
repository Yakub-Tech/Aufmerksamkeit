generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comment {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  text      String
  gender    String?
  createdAt DateTime @default(now())
  likedBy   CommentLike[]
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  sessionId String
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, commentId])
}

model TestStat {
  id    Int @id @default(1)
  count Int @default(0)
}

model TestResult {
  id           Int      @id @default(autoincrement())
  elapsed      Int
  distractions Int
  createdAt    DateTime @default(now())
}
